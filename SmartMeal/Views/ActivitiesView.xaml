<UserControl x:Class="SmartMeal.Views.ActivitiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">

            <StackPanel>

                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard" Height="42" Margin="0,0,0,12"
                        Background="#1F2937" Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Dashboard_Click"/>

                <Button Content="Meals" Height="42" Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Meals_Click"/>

                <Button Content="Activities" Height="42" Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>

                <Button Content="History" Height="42" Margin="0,0,0,12"
                        Background="#1F2937" Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="History_Click"/>

                <Button Content="Recommendations" Height="42" Margin="0,0,0,12"
                        Background="#1F2937" Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Recommendations_Click"/>

                <Button Content="Profile" Height="42" Margin="0,0,0,12"
                        Background="#1F2937" Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Profile_Click"/>

                <Button Content="Log Out" Height="42" Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="BackToLog_Click"/>

            </StackPanel>

        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1" Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock Text="Activities"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <TextBlock Text="View and manage your activities."
                               FontSize="14"
                               Foreground="#6B7280"
                               Margin="0,6,0,0"/>

                </StackPanel>

                <Button Grid.Column="1"
                        Content="Add Activity"
                        Width="130"
                        Height="40"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="AddActivity_Click"/>

            </Grid>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20">

                <StackPanel>

                    <!-- DATA GRID -->
                    <DataGrid x:Name="ActivitiesDataGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              RowHeight="40"
                              MaxHeight="320"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Activity"
                                                Binding="{Binding Name}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Calories Burned"
                                                Binding="{Binding CaloriesBurned}"
                                                Width="150"/>

                            <DataGridTextColumn Header="Duration (min)"
                                                Binding="{Binding DurationMinutes}"
                                                Width="140"/>

                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding LoggedAt}"
                                                Width="180"/>

                            <DataGridTemplateColumn Header="Action" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Button Content="Delete"
                                                Width="80"
                                                Height="28"
                                                Background="#EF4444"
                                                Foreground="White"
                                                BorderThickness="0"
                                                Tag="{Binding ActivityId}"
                                                Click="DeleteActivity_Click"/>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- SUMMARY -->
                    <StackPanel Margin="0,20,0,0">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">

                            <Border Background="#EEF2FF" Padding="12" CornerRadius="10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Total Burned" Foreground="#4F46E5"/>
                                    <TextBlock Text="{Binding TotalBurned}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#ECFDF5" Padding="12" CornerRadius="10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="Average" Foreground="#059669"/>
                                    <TextBlock Text="{Binding AvgBurned}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#FEF2F2" Padding="12" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="Peak Day" Foreground="#DC2626"/>
                                    <TextBlock Text="{Binding MaxBurned}" FontSize="16" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>

                        </StackPanel>

                        <!-- TREND -->
                        <TextBlock Text="Last 7 Days Activity"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,12"/>

                        <ItemsControl x:Name="ActivityTrendItemsControl">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>

                                    <Border Background="#F9FAFB"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,6">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="80"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding Date}"
                                                       Foreground="#6B7280"
                                                       VerticalAlignment="Center"/>

                                            <ProgressBar Grid.Column="1"
                                                         Value="{Binding Calories}"
                                                         Maximum="1500"
                                                         Height="14"
                                                         VerticalAlignment="Center"/>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Calories}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </StackPanel>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</UserControl>