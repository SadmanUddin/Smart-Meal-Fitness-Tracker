<UserControl x:Class="SmartMeal.Views.AddMealView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Dashboard_Click"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="Meals_Click"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Activities_Click"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="History_Click"/>



                <Button Content="Recommendations"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Recommendations_Click"/>
                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Profile_Click"/>

                <Button Content="Log Out"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="BackToLog_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Add Meal"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Fill in the meal details below."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 3 Separate Boxes -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Food Item Box -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Food Item"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Type to search the USDA food database."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,12"/>

                        <!-- Search input -->
                        <TextBox x:Name="FoodSearchTextBox"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"
                                 TextChanged="FoodSearchTextBox_TextChanged"/>

                        <!-- Searching indicator -->
                        <TextBlock x:Name="SearchingLabel"
                                   Text="Searching..."
                                   FontSize="12"
                                   Foreground="#9CA3AF"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"/>

                        <!-- Results list (visible while searching, hidden after selection) -->
                        <Border x:Name="FoodResultsBorder"
                                Visibility="Collapsed"
                                Background="#F9FAFB"
                                CornerRadius="10"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                Margin="0,6,0,0"
                                MaxHeight="240">
                            <ListBox x:Name="FoodResultsListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="FoodResultsListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,6">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="#111827"/>
                                            <TextBlock Text="{Binding CaloriesLabel}"
                                                       FontSize="11"
                                                       Foreground="#6B7280"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <!-- Selected food chip (shown after picking a result) -->
                        <Border x:Name="SelectedFoodBorder"
                                Background="#EFF6FF"
                                CornerRadius="10"
                                Padding="12,8"
                                Margin="0,6,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedFoodLabel"
                                           FontSize="13"
                                           Foreground="#2563EB"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="Clear"
                                        FontSize="11"
                                        Height="24"
                                        Padding="8,0"
                                        Margin="8,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#6B7280"
                                        VerticalAlignment="Center"
                                        Click="ClearSelectedFood_Click"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Grams Box -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="18"
                        Padding="24"
                        MinHeight="180">
                    <StackPanel>
                        <TextBlock Text="Grams"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Enter the amount in grams."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,16"/>
                        <TextBox x:Name="GramsTextBox"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Meal Type Box -->
                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="18"
                        Padding="24"
                        MinHeight="180">
                    <StackPanel>
                        <TextBlock Text="Meal Type"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Select breakfast, lunch, etc."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,16"/>
                        <ComboBox x:Name="MealTypeComboBox"
                                  Height="42"
                                  FontSize="14"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="18"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Review the values and save the meal to your tracker."
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#6B7280"/>

                    <Button Grid.Column="1"
                            Content="Cancel"
                            Width="110"
                            Height="40"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="Cancel_Click"/>

                    <Button Grid.Column="3"
                            Content="Add Meal"
                            Width="130"
                            Height="40"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="AddMeal_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
