<UserControl x:Class="SmartMeal.Views.AddMealView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="AddMeal_Click"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Activities_Click"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="History_Click"/>

                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Profile_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Area -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Add Meal"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Fill in the meal details below."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- 3 Separate Boxes -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Meal Name Box -->
                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="18"
                        Padding="24"
                        MinHeight="180">
                    <StackPanel>
                        <TextBlock Text="Meal Name"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Enter the name of the meal."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,16"/>
                        <TextBox x:Name="MealNameTextBox"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Calories Box -->
                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="18"
                        Padding="24"
                        MinHeight="180">
                    <StackPanel>
                        <TextBlock Text="Calories"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Enter the calorie amount."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,16"/>
                        <TextBox x:Name="CaloriesTextBox"
                                 Height="42"
                                 Padding="10"
                                 FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Category Box -->
                <Border Grid.Column="4"
                        Background="White"
                        CornerRadius="18"
                        Padding="24"
                        MinHeight="180">
                    <StackPanel>
                        <TextBlock Text="Category"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>
                        <TextBlock Text="Select the meal category."
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,16"/>
                        <ComboBox x:Name="CategoryComboBox"
                                  Height="42"
                                  FontSize="14">
                            <ComboBoxItem Content="Breakfast"/>
                            <ComboBoxItem Content="Lunch"/>
                            <ComboBoxItem Content="Dinner"/>
                            <ComboBoxItem Content="Snack"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Buttons -->
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="18"
                    Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Review the values and save the meal to your tracker."
                               VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="#6B7280"/>

                    <Button Grid.Column="1"
                            Content="Cancel"
                            Width="110"
                            Height="40"
                            Background="#E5E7EB"
                            Foreground="#111827"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="Cancel_Click"/>

                    <Button Grid.Column="3"
                            Content="Add Meal"
                            Width="130"
                            Height="40"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="AddMeal_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>