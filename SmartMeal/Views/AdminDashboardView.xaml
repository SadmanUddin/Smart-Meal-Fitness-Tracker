<UserControl x:Class="SmartMeal.Views.AdminDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,4"/>

                <TextBlock Text="Admin Panel"
                           Foreground="#9CA3AF"
                           FontSize="13"
                           Margin="0,0,0,30"/>

                <Button Content="Users"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>

                <Button Content="Log Out"
                        Height="42"
                        Margin="0,300,0,0"
                        Background="#1F2937"
                        Foreground="#F87171"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="LogOut_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="User Management"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="View, search, and manage all registered users."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>

            </StackPanel>

            
            <UniformGrid Grid.Row="2"
                         Columns="3"
                         Margin="0">

                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Total Users"
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="TotalUsersBlock"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Active Users"
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="ActiveUsersBlock"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#10B981"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Padding="20">

                    <StackPanel>
                        <TextBlock Text="Banned Users"
                                   FontSize="13"
                                   Foreground="#6B7280"/>

                        <TextBlock x:Name="BannedUsersBlock"
                                   Text="—"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#EF4444"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Border>

            </UniformGrid>

            
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="18"
                    Padding="24">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="All Users"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <DataGrid x:Name="UsersDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderThickness="0"
                              RowBackground="White"
                              AlternatingRowBackground="#F9FAFB"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              HeadersVisibility="Column"
                              RowHeight="42"
                              MaxHeight="300"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding FullName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Email"
                                                Binding="{Binding Email}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Role"
                                                Binding="{Binding Role}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Joined"
                                                Binding="{Binding JoinedDate}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="80"/>

                            <DataGridTemplateColumn Header="Action"
                                                    Width="95">

                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>

                                        <Button Content="{Binding ActionLabel}"
                                                Tag="{Binding UserId}"
                                                Click="BanToggle_Click"
                                                Width="80"
                                                Height="30"
                                                Background="{Binding ActionColor}"
                                                Foreground="White"
                                                BorderThickness="0"/>

                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>

                            </DataGridTemplateColumn>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

            <Border Grid.Row="6"
                    Background="White"
                    CornerRadius="18"
                    Padding="24">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Leaderboard"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <DataGrid x:Name="LeaderboardGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="White"
                              BorderThickness="0"
                              RowBackground="White"
                              AlternatingRowBackground="#F9FAFB"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5E7EB"
                              RowHeight="42"
                              MaxHeight="300"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Columns>

                            <DataGridTextColumn Header="#"
                                                Binding="{Binding Rank}"
                                                Width="40"/>

                            <DataGridTextColumn Header="Name"
                                                Binding="{Binding FullName}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Score"
                                                Binding="{Binding Score}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Active Days"
                                                Binding="{Binding ActiveDays}"
                                                Width="100"/>

                            <DataGridTextColumn Header="Meals"
                                                Binding="{Binding MealLogs}"
                                                Width="80"/>

                            <DataGridTextColumn Header="Activities"
                                                Binding="{Binding ActivityLogs}"
                                                Width="90"/>

                            <DataGridTextColumn Header="Weights"
                                                Binding="{Binding WeightLogs}"
                                                Width="90"/>

                        </DataGrid.Columns>

                    </DataGrid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>