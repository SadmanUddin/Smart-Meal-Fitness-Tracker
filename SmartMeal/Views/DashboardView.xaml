<UserControl x:Class="SmartMeal.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Meals_Click"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="AddActivity_Click"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="History_Click"/>

                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Profile_Click"/>
                <Button Content="Log Out"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="BackToLog_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Welcome Back"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#111827"/>
                    <TextBlock Text="Track your meals, fitness activities, and daily progress."
                               FontSize="14"
                               Foreground="#6B7280"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="White"
                        CornerRadius="12"
                        Padding="14,10"
                        VerticalAlignment="Center">
                    <TextBlock Text="Today"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                </Border>
            </Grid>

            <!-- Separate Goal Card -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Daily Calories Goal"
                                   FontSize="14"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="CaloriesGoalBlock"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,6,0,0"/>
                        <TextBlock x:Name="TargetWeightGoalBlock"
                                   Text=""
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Set Goal"
                            Width="120"
                            Height="38"
                            Background="#F59E0B"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            VerticalAlignment="Center"
                            Click="SetGoal_Click"/>
                </Grid>
            </Border>

            <!-- Summary Cards -->
            <UniformGrid Grid.Row="4" Columns="6" Margin="0">
                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Calories Consumed"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="CaloriesConsumedBlock"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Meals"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="MealsCountBlock"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Activities"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="ActivitiesCountBlock"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Calories Burned"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="CaloriesBurnedBlock"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Balance"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="BalanceBlock"
                                   Text="0"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="BMI"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="BmiValueBlock"
                                   Text="—"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,10,0,0"/>
                        <TextBlock x:Name="BmiCategoryBlock"
                                   Text=""
                                   FontSize="11"
                                   Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Lower Section -->
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Background="White"
                        CornerRadius="18"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Start using the system by adding meals, activities, and setting up your fitness goal."
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Foreground="#6B7280"
                                   Margin="0,0,0,20"/>

                        <WrapPanel>
                            <Button Content="Add Meal"
                                    Width="150"
                                    Height="42"
                                    Margin="0,0,12,0"
                                    Background="#2563EB"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Click="AddMeal_Click"/>

                            <Button Content="Add Activity"
                                    Width="150"
                                    Height="42"
                                    Margin="0,0,12,0"
                                    Background="#10B981"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Click="AddActivity_Click"/>

                            <Button Content="Set Goal"
                                    Width="150"
                                    Height="42"
                                    Background="#F59E0B"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Click="SetGoal_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="18"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Recent Activity"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,0,0,16"/>

                        <Border Background="#F9FAFB"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="RecentMealsTextBlock"
                                       Text="No meals added yet."
                                       Foreground="#6B7280"/>
                        </Border>

                        <Border Background="#F9FAFB"
                                CornerRadius="12"
                                Padding="14"
                                Margin="0,0,0,12">
                            <TextBlock x:Name="RecentActivitiesTextBlock"
                                       Text="No activities added yet."
                                       Foreground="#6B7280"/>
                        </Border>

                        <Border Background="#F9FAFB"
                                CornerRadius="12"
                                Padding="14">
                            <TextBlock Text="No history available yet."
                                       Foreground="#6B7280"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
