<UserControl x:Class="SmartMeal.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="Dashboard_Click"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="AddMeal_Click"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="Activities_Click"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>

                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="Profile_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="History"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="View your meals and activities in one place."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="20">
                <DataGrid x:Name="HistoryDataGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          RowHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="180"/>
                        <DataGridTextColumn Header="Calories" Binding="{Binding Calories}" Width="120"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>