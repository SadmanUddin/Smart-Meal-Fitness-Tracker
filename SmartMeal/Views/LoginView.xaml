<UserControl x:Class="SmartMeal.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#F5F7FA">
        <Border Width="524"
                Padding="30"
                Background="White"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" Height="513">
            <StackPanel>

                <TextBlock Text="Smart Meal &amp; Fitness Tracker"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Login"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Email"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="EmailTextBox"
                         Height="38"
                         Margin="0,0,0,14"
                         Padding="10"
                         FontSize="14"/>

                <TextBlock Text="Password"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             Margin="0,0,0,20"
                             Padding="10"
                             FontSize="14"/>

                <Button Content="Login"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>

                                <TextBlock Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#6B7280">
                    Don't have an account?
                    <Run Text=" Register"
                         Foreground="#2563EB"
                         FontWeight="SemiBold"
                         TextDecorations="Underline"
                         Cursor="Hand"
                         MouseLeftButtonDown="RegisterText_MouseLeftButtonDown"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>