<UserControl x:Class="SmartMeal.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Dashboard_Click"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Meals_Click"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Activities_Click"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="History_Click"/>

                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Profile"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Update your personal details used across the app."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="24"
                    MaxWidth="920"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Full Name"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="FullNameTextBox"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="EmailTextBox"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"
                                     IsReadOnly="True"
                                     Background="#F9FAFB"
                                     BorderBrush="#E5E7EB"
                                     Foreground="#6B7280"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Age"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="AgeTextBox"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Height (cm)"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="HeightTextBox"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Weight (kg)"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="WeightTextBox"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Gender"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                            <ComboBox x:Name="GenderComboBox"
                                      Height="40"
                                      FontSize="14"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Prefer not to say" Tag=""/>
                                <ComboBoxItem Content="Male" Tag="male"/>
                                <ComboBoxItem Content="Female" Tag="female"/>
                                <ComboBoxItem Content="Other" Tag="other"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Role"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="RoleTextBox"
                                     Height="40"
                                     Padding="10"
                                     FontSize="14"
                                     IsReadOnly="True"
                                     Background="#F9FAFB"
                                     BorderBrush="#E5E7EB"
                                     Foreground="#6B7280"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="6"
                            Background="#F9FAFB"
                            CornerRadius="10"
                            Padding="12">
                        <TextBlock Text="Changing weight here updates your profile snapshot. Use History to add dated weigh-ins to your chart."
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="#6B7280"/>
                    </Border>

                    <WrapPanel Grid.Row="8" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Width="110"
                                Height="40"
                                Margin="0,0,12,0"
                                Background="#E5E7EB"
                                Foreground="#111827"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="Cancel_Click"/>

                        <Button Content="Save Profile"
                                Width="130"
                                Height="40"
                                Background="#2563EB"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="SaveProfile_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
