<UserControl x:Class="SmartMeal.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="Dashboard_Click"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"/>

                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="28">
            <Border Background="White"
                    CornerRadius="18"
                    Padding="30"
                    Width="500"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <TextBlock Text="My Profile"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#111827"
                               Margin="0,0,0,25"/>

                    <TextBlock Text="Full Name"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="NameBlock"
                               FontSize="16"
                               Margin="0,6,0,18"/>

                    <TextBlock Text="Email"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="EmailBlock"
                               FontSize="16"
                               Margin="0,6,0,18"/>

                    <TextBlock Text="Role"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="RoleBlock"
                               FontSize="16"
                               Margin="0,6,0,18"/>

                    <TextBlock Text="Account Created"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="CreatedAtBlock"
                               FontSize="16"
                               Margin="0,6,0,0"/>
                </StackPanel>

            </Border>
        </Grid>
    </Grid>
</UserControl>