<UserControl x:Class="SmartMeal.Views.RecommendationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="Dashboard_Click"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="AddMeal_Click"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="Activities_Click"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="History_Click"/>

                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        Click="Profile_Click"/>

                <Button Content="Recommendation"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="AI Recommendation"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Generate a personalized recommendation based on your meals, activities, and goal."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Summary Cards -->
            <UniformGrid Grid.Row="2" Columns="4">
                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Goal"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="GoalBlock"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Consumed"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="ConsumedBlock"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Margin="0,0,16,0"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Burned"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="BurnedBlock"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White"
                        CornerRadius="16"
                        Padding="18">
                    <StackPanel>
                        <TextBlock Text="Balance"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                        <TextBlock x:Name="BalanceBlock"
                                   Text="0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#111827"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Recommendation Card -->
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="18"
                    Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Personal Recommendation"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#111827"/>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="RecommendationTextBlock"
                                   Text="Click the button below to generate a recommendation."
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   Foreground="#4B5563"
                                   LineHeight="24"/>
                    </ScrollViewer>

                    <Button Grid.Row="4"
                            Content="Generate Recommendation"
                            Width="220"
                            Height="42"
                            HorizontalAlignment="Left"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="GenerateRecommendation_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>