<UserControl x:Class="SmartMeal.Views.RecommendationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Dashboard_Click"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Meals_Click"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Activities_Click"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="History_Click"/>

                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Profile_Click"/>

                <Button Content="Recommendations"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>

                <Button Content="Log Out"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="BackToLog_Click"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel>
                <TextBlock Text="Meal Recommendations"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="AI-powered daily meal plan based on your goal, preferences, and allergies."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Preferences summary bar -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Text="Goal: "
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="GoalSummaryBlock"
                                   Text="— kcal"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="2,0,16,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Preferences: "
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PreferencesSummaryBlock"
                                   Text="None set"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#111827"
                                   Margin="2,0,16,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Allergies: "
                                   FontSize="13"
                                   Foreground="#6B7280"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="AllergiesSummaryBlock"
                                   Text="None set"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#EF4444"
                                   Margin="2,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            x:Name="GenerateButton"
                            Content="Generate Plan"
                            Width="140"
                            Height="38"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Click="Generate_Click"/>
                </Grid>
            </Border>

            <!-- Tab area -->
            <Border Grid.Row="4"
                    Background="White"
                    CornerRadius="18"
                    Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status label shown while generating or on error -->
                    <Border x:Name="StatusBorder"
                            Background="#F0F9FF"
                            CornerRadius="10"
                            Padding="14,10"
                            Visibility="Collapsed">
                        <TextBlock x:Name="StatusBlock"
                                   Text=""
                                   FontSize="14"
                                   Foreground="#0369A1"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Meal tabs -->
                    <TabControl Grid.Row="2"
                                x:Name="MealTabControl"
                                Background="Transparent"
                                BorderThickness="0">
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Padding" Value="16,8"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#2563EB"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>
                        <TabItem Header="Breakfast">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <ItemsControl x:Name="BreakfastList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB"
                                                    CornerRadius="12"
                                                    Padding="16"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="13"
                                                                   Foreground="#6B7280"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Background="#ECFDF5"
                                                            CornerRadius="8"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#10B981">
                                                            <Run Text="{Binding Calories}"/>
                                                            <Run Text=" kcal"/>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Lunch">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <ItemsControl x:Name="LunchList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB"
                                                    CornerRadius="12"
                                                    Padding="16"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="13"
                                                                   Foreground="#6B7280"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Background="#ECFDF5"
                                                            CornerRadius="8"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#10B981">
                                                            <Run Text="{Binding Calories}"/>
                                                            <Run Text=" kcal"/>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Dinner">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <ItemsControl x:Name="DinnerList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB"
                                                    CornerRadius="12"
                                                    Padding="16"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="13"
                                                                   Foreground="#6B7280"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Background="#ECFDF5"
                                                            CornerRadius="8"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#10B981">
                                                            <Run Text="{Binding Calories}"/>
                                                            <Run Text=" kcal"/>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Snacks">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                <ItemsControl x:Name="SnacksList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB"
                                                    CornerRadius="12"
                                                    Padding="16"
                                                    Margin="0,0,0,12">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#111827"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="13"
                                                                   Foreground="#6B7280"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1"
                                                            Background="#ECFDF5"
                                                            CornerRadius="8"
                                                            Padding="10,4"
                                                            VerticalAlignment="Center">
                                                        <TextBlock FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#10B981">
                                                            <Run Text="{Binding Calories}"/>
                                                            <Run Text=" kcal"/>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
