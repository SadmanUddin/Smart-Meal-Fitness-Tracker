<UserControl x:Class="SmartMeal.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#F5F7FA">
        <Border Width="532"
                Padding="30"
                Background="White"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Height="648">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="0"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel>

                <TextBlock Text="Smart Meal &amp; Fitness Tracker"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Create Account"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Full Name"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="FullNameTextBox"
                         Height="38"
                         Margin="0,0,0,14"
                         Padding="10"
                         FontSize="14"/>

                <TextBlock Text="Email"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="EmailTextBox"
                         Height="38"
                         Margin="0,0,0,14"
                         Padding="10"
                         FontSize="14"/>

                <TextBlock Text="Password"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             Margin="0,0,0,14"
                             Padding="10"
                             FontSize="14"/>

                <TextBlock Text="Confirm Password"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0,0,0,6"/>
                <PasswordBox x:Name="ConfirmPasswordBox"
                             Height="38"
                             Margin="0,0,0,20"
                             Padding="10"
                             FontSize="14"/>

                <Button Content="Register"
                            Height="42"
                            Background="#2563EB"
                            Foreground="White"
                            FontSize="15"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="RegisterButton_Click"/>

                                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="#6B7280">
                        Already have an account?
                        <Run Text=" Login"
                             Foreground="#2563EB"
                             FontWeight="SemiBold"
                             TextDecorations="Underline"
                             Cursor="Hand"
                             MouseLeftButtonDown="LoginText_MouseLeftButtonDown"/>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>