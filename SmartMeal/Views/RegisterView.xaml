<UserControl x:Class="SmartMeal.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#F5F7FA">
        <Border Width="580"
                Padding="36,30"
                Background="White"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <StackPanel>

                <TextBlock Text="Smart Meal &amp; Fitness Tracker"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1F2937"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <TextBlock Text="Create Account"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,22"/>

                <!-- Full Name -->
                <TextBlock Text="Full Name"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="FullNameTextBox"
                         Height="38"
                         Margin="0,0,0,14"
                         Padding="10"
                         FontSize="14"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#374151"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="EmailTextBox"
                         Height="38"
                         Margin="0,0,0,14"
                         Padding="10"
                         FontSize="14"/>

                <!-- Password | Confirm Password -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Password"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Height="38"
                                     Padding="10"
                                     FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Confirm Password"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Height="38"
                                     Padding="10"
                                     FontSize="14"/>
                    </StackPanel>
                </Grid>

                <!-- Section divider -->
                <TextBlock Text="Profile Details (optional)"
                           FontSize="12"
                           Foreground="#9CA3AF"
                           FontWeight="SemiBold"
                           Margin="0,4,0,12"/>

                <!-- Age | Gender -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Age"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="AgeTextBox"
                                 Height="38"
                                 Padding="10"
                                 FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Gender"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>
                        <ComboBox x:Name="GenderComboBox"
                                  Height="38"
                                  FontSize="14">
                            <ComboBoxItem Content="Prefer not to say" Tag="" IsSelected="True"/>
                            <ComboBoxItem Content="Male" Tag="male"/>
                            <ComboBoxItem Content="Female" Tag="female"/>
                            <ComboBoxItem Content="Other" Tag="other"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Height | Starting Weight -->
                <Grid Margin="0,0,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Height (cm)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="HeightTextBox"
                                 Height="38"
                                 Padding="10"
                                 FontSize="14"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Starting Weight (kg)"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"/>
                        <TextBox x:Name="WeightTextBox"
                                 Height="38"
                                 Padding="10"
                                 FontSize="14"/>
                    </StackPanel>
                </Grid>

                <Button Content="Register"
                        Height="42"
                        Background="#2563EB"
                        Foreground="White"
                        FontSize="15"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="RegisterButton_Click"/>

                <TextBlock Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           FontSize="13"
                           Foreground="#6B7280">
                    Already have an account?
                    <Run Text=" Login"
                         Foreground="#2563EB"
                         FontWeight="SemiBold"
                         TextDecorations="Underline"
                         Cursor="Hand"
                         MouseLeftButtonDown="LoginText_MouseLeftButtonDown"/>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
