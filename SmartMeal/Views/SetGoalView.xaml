<UserControl x:Class="SmartMeal.Views.SetGoalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">

    <Grid Background="#EEF2F7">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#111827"
                Padding="24">
            <StackPanel>
                <TextBlock Text="Smart Meal"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,30"/>

                <Button Content="Dashboard"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Dashboard_Click"/>

                <Button Content="Meals"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Meals_Click"/>

                <Button Content="Activities"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Activities_Click"/>

                <Button Content="History"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="History_Click"/>



                <Button Content="Recommendations"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Recommendations_Click"/>
                <Button Content="Profile"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="Profile_Click"/>

                <Button Content="Log Out"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"/>

                <Button Content="Log Out"
                        Height="42"
                        Margin="0,0,0,12"
                        Background="#1F2937"
                        Foreground="White"
                        BorderBrush="#374151"
                        FontWeight="SemiBold"
                        Click="BackToLog_Click"/>
            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="Set Daily Goal"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#111827"/>
                <TextBlock Text="Set your target daily calorie goal."
                           FontSize="14"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="18"
                    Padding="30"
                    Width="520"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Daily Calories Goal"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="DailyGoalTextBox"
                             Height="42"
                             Margin="0,10,0,24"
                             Padding="10"
                             FontSize="14"/>

                    <TextBlock Text="Target Weight (kg)"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#374151"/>
                    <TextBox x:Name="TargetWeightTextBox"
                             Height="42"
                             Margin="0,10,0,8"
                             Padding="10"
                             FontSize="14"/>
                    <TextBlock Text="Optional. Shown on your weight history chart as a target line."
                               FontSize="12"
                               Foreground="#9CA3AF"
                               Margin="0,0,0,24"/>

                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Width="110"
                                Height="40"
                                Margin="0,0,12,0"
                                Background="#E5E7EB"
                                Foreground="#111827"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="Cancel_Click"/>

                        <Button Content="Save Goal"
                                Width="130"
                                Height="40"
                                Background="#F59E0B"
                                Foreground="White"
                                BorderThickness="0"
                                FontWeight="SemiBold"
                                Click="SetGoal_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>